# apps/api — port 3001
# Import into Doppler (tabit / dev) or copy for local reference.
NODE_ENV=development
PORT=3001

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/tabit

# Redis — notification enqueue (services → BullMQ)
REDIS_URL=redis://localhost:6379

# Auth (packages/auth)
BETTER_AUTH_SECRET=dev_secret_min_32_characters_long
# Leave empty for localhost; use .tabit.in in prod
BETTER_AUTH_COOKIE_DOMAIN=
BETTER_AUTH_TRUSTED_ORIGINS=https://localhost:3003,http://localhost:3003
VITE_API_URL=http://localhost:3001

# CORS — comma-separated PWA origins
CORS_ORIGIN=https://localhost:3003,http://localhost:3003

# Email OTP (optional — OTP logs to console if unset)
PLUNK_SECRET_KEY=
PLUNK_BASE_URL=

# Public URLs (invite links, auth trustedOrigins)
NEXT_PUBLIC_PWA_URL=https://localhost:3003
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# AI expense parsing (@ai-sdk/google reads this env var)
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: set to 0 to disable IP timezone lookup on profile
TIMEZONE_IP_LOOKUP=1

# Discord alerts (new users, etc.)
DISCORD_WEBHOOK_URL=

# OpenTelemetry (optional)
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=tab-api
