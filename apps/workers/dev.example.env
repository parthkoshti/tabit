# apps/workers — port 3002 (Socket.IO + BullMQ + crons)
# Uses repo certs/ for HTTPS when present (match HTTPS PWA in local dev).
# Import into Doppler (tabit / dev) or copy for local reference.
NODE_ENV=development
PORT=3002

DATABASE_URL=postgresql://user:password@localhost:5432/tabit
REDIS_URL=redis://localhost:6379

# Socket.IO CORS — must include PWA origin(s)
CORS_ORIGIN=https://localhost:3003,http://localhost:3003

# Auth session validation (same secret as api)
BETTER_AUTH_SECRET=dev_secret_min_32_characters_long
VITE_API_URL=http://localhost:3001
NEXT_PUBLIC_PWA_URL=https://localhost:3003

# Web push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Push deep links / invite URLs
NEXT_PUBLIC_WEB_URL=http://localhost:3000
APP_URL=https://localhost:3003

# Cron failure alerts
DISCORD_WEBHOOK_URL=

# OpenTelemetry (optional)
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=tab-workers
