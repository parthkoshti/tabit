# apps/pwa — port 3003 (HTTPS if certs/ exist in repo certs/)
# Import into Doppler (tabit / dev) or copy for local reference.
NODE_ENV=development

# Recommended local dev: leave VITE_API_URL unset.
# Vite proxies /rpc and /api/auth → localhost:3001.
# Auth client uses window.location.origin when VITE_API_URL is unset.
# VITE_API_URL=

# If testing cross-origin explicitly:
# VITE_API_URL=http://localhost:3001

# Socket.IO workers (direct). Use https when PWA uses HTTPS locally (requires certs/).
VITE_REALTIME_URL=https://localhost:3002

# Public / baked into client
NEXT_PUBLIC_PWA_URL=https://localhost:3003
NEXT_PUBLIC_DONATE_URL=https://paypal.me/parthk

# Web push subscription (must match workers VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=

# Query persistence buster (optional — __APP_VERSION__ is primary)
# VITE_QUERY_CACHE_BUSTER=v1
